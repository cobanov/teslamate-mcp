# TeslaMate MCP Server — environment variables

# REQUIRED: PostgreSQL connection string for the TeslaMate database.
# Use a dedicated read-only role, NOT TeslaMate's own `teslamate` user — its
# Compose makes that one a superuser, which lets run_sql read files inside the
# database container even though writes stay blocked. See SECURITY.md.
DATABASE_URL=postgresql://teslamate_ro:password@localhost:5432/teslamate

# Optional: bearer token for the HTTP transport. Leave empty to disable auth.
# Generate one with: uv run teslamate-mcp gen-token
AUTH_TOKEN=

# Optional overrides (defaults shown).
# HOST=0.0.0.0
# PORT=8888
# POOL_MIN_SIZE=1
# POOL_MAX_SIZE=10
# STATEMENT_TIMEOUT_MS=30000        # bounds every query, including the bundled reports
# QUERY_TIMEOUT_MS=5000             # tighter bound applied to run_sql specifically
# CUSTOM_SQL_ROW_LIMIT=1000
# REPORT_TIMEZONE=Europe/Istanbul   # IANA timezone for daily/monthly buckets (default UTC)
# ENABLE_CHARGING_WRITES=false      # register set_charging_cost (needs UPDATE(cost) grant)
# LOG_LEVEL=INFO
# DEBUG=false

# Optional observability (0.8.0+): export per-request OpenTelemetry traces.
# Tracing stays off entirely unless an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.100:4318
# OTEL_SERVICE_NAME=teslamate-mcp
